# Шаблон для /etc/devops/app.env. Systemd загружает его через EnvironmentFile.
# Копирование .env само по себе НЕ загружает переменные в Python.
DB_HOST=CHANGE_ME_DATABASE_IPV4
APP_HOST=CHANGE_ME_APPLICATION_IPV4
DB_PORT=5432
DB_NAME=devops
DB_USER=devops_app
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
PORT=5000
APP_VERSION=0.2.0
SECRET_KEY=CHANGE_ME_RANDOM_SESSION_SECRET
# Только для первого создания admin; существующий пароль не обновляется.
ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD
