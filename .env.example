# Пример настроек. Скопируй в .env и впиши свои значения.
# НИКОГДА не клади настоящий .env в git!
DATABASE_PATH=data/app.db
PORT=5000
APP_VERSION=0.1.0
# Секрет для сессий входа (придумать свой длинный, никому не показывать):
SECRET_KEY=change-me-please
# Стартовый пароль пользователя admin (меняется здесь, не в коде):
ADMIN_PASSWORD=admin123
